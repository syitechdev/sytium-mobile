<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements du build Release (App Store / TestFlight). 'production' est
	     obligatoire : avec 'development' l'app publiee recoit des jetons APNs
	     SANDBOX et ne recoit plus ni notification ni appel VoIP.
	     A builder avec --dart-define=VOIP_ENV=production pour que le backend
	     vise le meme hote APNs. Debug/Profile utilisent RunnerDebug.entitlements. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
